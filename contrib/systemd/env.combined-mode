# ==========================================
# Systemd: Combined mode (recommended for >50 VMs)
# ==========================================
# Quick checks + full sync on intervals.
#
# Usage on host / in LXC:
#   sudo cp contrib/systemd/env.combined-mode /etc/pve2netbox/env
#   (or create /etc/pve2netbox/env from this template)
# Run: sudo systemctl enable --now pve2netbox

# PVE API (required)
PVE_API_HOST=10.10.0.10
PVE_API_USER=netsync@pve
PVE_API_TOKEN=test-token
PVE_API_SECRET=your-secret-here

# NetBox API (required)
NB_API_URL=https://netbox.example.org
NB_API_TOKEN=your-netbox-token-here

# Optional
PVE_API_VERIFY_SSL=false
NB_CLUSTER_ID=1
NB_API_DELAY_SECONDS=0.2
NB_API_RETRY_TOTAL=5
NB_API_RETRY_BACKOFF=1.0

# Behaviour when a Proxmox node has no matching device in NetBox:
#   skip = log an error and continue with the other nodes (default)
#   fail = stop the run
NODE_MISSING_POLICY=skip

# Health endpoints /healthz and /readyz on METRICS_PORT (independent of ENABLE_METRICS)
ENABLE_HEALTH_ENDPOINT=true

# Combined mode
QUICK_CHECK_INTERVAL_SECONDS=60
SYNC_INTERVAL_SECONDS=3600

SYNC_VMS=true
SYNC_LXC=true
SYNC_TAGS=true

# IP addresses of LXC containers:
#   auto    = real addresses of a running container, falling back to the static config (default)
#   runtime = only the running container's addresses (the only source that works for DHCP)
#   config  = only the static ip=/ip6= values from the container config
#   none    = do not sync container IPs (behaviour before 1.1.0)
LXC_IP_SOURCE=auto

# Proxmox description (Notes) -> NetBox. Target: comments (multi-line) or description (200 chars).
SYNC_DESCRIPTION=true
DESCRIPTION_TARGET=comments

# ostype -> NetBox Platform, pool -> NetBox Tenant. Opt-in: these fields are often kept by hand.
SYNC_PLATFORM=false
POOL_AS_TENANT=false

# Templates: tag (sync and mark with the tag "pve-template"), skip, or sync (no marking)
TEMPLATE_POLICY=tag

# Selecting what to sync (optional). Comma- or space-separated, case-insensitive.
# Filtered guests are never deleted by ENABLE_CLEANUP — they still exist in Proxmox.
# SYNC_NODES=pve1,pve2
# EXCLUDE_NODES=pve-test
# SYNC_POOLS=prod,dmz
# INCLUDE_TAGS=netbox
# EXCLUDE_TAGS=no-netbox
# EXCLUDE_VMIDS=100,105,900-999

# How much of NetBox is read before each sync: cluster (default) or all (pre-1.2.0 behaviour)
# NB_PRELOAD_SCOPE=cluster
