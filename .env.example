# PVE API (required)
PVE_API_HOST=10.10.0.10
PVE_API_USER=netsync@pve
PVE_API_TOKEN=test-token
PVE_API_SECRET=your-secret

# NetBox API (required)
NB_API_URL=https://netbox.example.org
NB_API_TOKEN=your-netbox-token

# NetBox cluster (required: set one of the two; any existing ID works, nothing assumes 1)
NB_CLUSTER_ID=1                    # ID of an existing NetBox cluster
# NB_CLUSTER_NAME=pve-prod         # Cluster by name; created (with cluster type "Proxmox VE") if missing
#                                  # Setting both is only allowed when they point at the same cluster

# Optional
# PVE_API_VERIFY_SSL=false         # Default false; becomes true in 2.0.0 — set it explicitly
# NB_API_DELAY_SECONDS=0.2
# NB_API_RETRY_TOTAL=5
# NB_API_RETRY_BACKOFF=1.0

# Operation modes:
# 1. Single-run: do not set any of the variables below
# 2. Simple mode: set only SYNC_INTERVAL_SECONDS (full sync every N seconds)
# 3. Combined mode: set QUICK_CHECK_INTERVAL_SECONDS
#    - Quick change check every QUICK_CHECK_INTERVAL_SECONDS (e.g. 60 = 1 minute). On changes — sync only changed VMs
#    - Full sync every SYNC_INTERVAL_SECONDS (e.g. 3600 = 1 hour)

# SYNC_INTERVAL_SECONDS=3600
# QUICK_CHECK_INTERVAL_SECONDS=60

# Types to sync (default all = true)
# SYNC_VMS=true
# SYNC_LXC=true
# SYNC_TAGS=true               # Sync PVE tags to NetBox virtual machines (true/false)

# NetBox device roles for VM and LXC (name or ID; created automatically if missing)
# VM_ROLE=Virtual Machine
# LXC_ROLE=Container

# Additional options
# NODE_MISSING_POLICY=skip         # Proxmox node without a NetBox device: skip (default) or fail
# DRY_RUN=false                    # Partial: skips provisioning, node status and cleanup only — see README
# ENABLE_CLEANUP=false             # Remove from NetBox VMs missing in Proxmox (true/false)
# LOG_LEVEL=INFO                   # Log level (DEBUG, INFO, WARNING, ERROR)

# LXC IP addresses (optional)
# LXC_IP_SOURCE=auto              # auto (default) = running container's real addresses, falling
#                                 #   back to the static ip=/ip6= from the config
#                                 # runtime = only the running container's addresses (DHCP-aware)
#                                 # config  = only the static addresses from the container config
#                                 # none    = do not sync container IPs (behaviour before 1.1.0)

# Proxmox notes -> NetBox (optional)
# SYNC_DESCRIPTION=true           # Copy the PVE description (Notes) to NetBox
# DESCRIPTION_TARGET=comments     # comments (default, multi-line) or description (short, 200 chars)

# ostype -> NetBox Platform (optional, opt-in: the field is often maintained by hand)
# SYNC_PLATFORM=false
# PLATFORM_MAP=l26=Linux,win11=Windows 11   # Override the built-in ostype mapping

# Proxmox pool -> NetBox Tenant (optional, opt-in). Pool tags keep working either way.
# POOL_AS_TENANT=false

# Templates (VMs with template: 1)
# TEMPLATE_POLICY=tag             # tag (default) = sync and mark with the tag "pve-template"
#                                 # skip = do not sync (and delete when ENABLE_CLEANUP=true)
#                                 # sync = treat like any other VM (behaviour before 1.1.0)

# Selecting what to sync (optional). Comma- or space-separated, case-insensitive.
# A guest must pass every filter that is set. Filtered guests are NEVER deleted by
# ENABLE_CLEANUP — they still exist in Proxmox, they are just not synced.
# SYNC_NODES=pve1,pve2            # Only these Proxmox nodes
# EXCLUDE_NODES=pve-test          # Skip these nodes
# SYNC_POOLS=prod,dmz             # Only guests in these Proxmox pools
# INCLUDE_TAGS=netbox             # Only guests carrying one of these PVE tags
# EXCLUDE_TAGS=no-netbox          # Skip guests carrying one of these PVE tags
# EXCLUDE_VMIDS=100,105,900-999   # Single IDs and inclusive ranges

# How much of NetBox is read before each sync (optional)
# NB_PRELOAD_SCOPE=cluster        # cluster (default) = only this cluster's VMs, their interfaces
#                                 #   and disks, plus the devices named like the Proxmox nodes
#                                 # all = every device, VM, interface and disk (behaviour before 1.2.0)
#                                 # IPs, prefixes, MACs, VLANs, tags and roles are always global

# Primary IP selection (optional)
# PRIMARY_SUBNETS=192.168.88.0/24, 2001:db8::/64
# Applies to LXC as well, unless LXC_IP_SOURCE=none

# Prometheus metrics and health endpoints (optional)
# ENABLE_METRICS=false             # Enable /metrics (true/false)
# ENABLE_HEALTH_ENDPOINT=true      # Enable /healthz and /readyz (true/false)
# METRICS_PORT=9090                # Port for /metrics, /healthz and /readyz
